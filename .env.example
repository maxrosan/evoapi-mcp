# Configuração do servidor Evolution API
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_TOKEN=seu-token-aqui
EVOLUTION_INSTANCE_NAME=minha-instancia

# Opcional: Timeout para requisições (em segundos)
# EVOLUTION_TIMEOUT=30

# Opcional: economia de tokens
# Pasta onde download_media grava os anexos (padrão: ~/.evoapi-mcp/media)
# EVOLUTION_MEDIA_DIR=~/.evoapi-mcp/media
# Quantidade padrão de mensagens/chats/contatos por chamada (padrão: 20)
# EVOLUTION_DEFAULT_LIMIT=20
# Corte do texto de cada mensagem no modo compacto, 0 = sem corte (padrão: 500)
# EVOLUTION_MAX_TEXT_CHARS=500

# Opcional: transcrição de áudios (voice notes) do WhatsApp
# auto (padrão) usa a API se houver chave, senão o modelo local; api | local | off
# EVOLUTION_TRANSCRIBE_BACKEND=auto
# Endpoint compatível com a API da OpenAI (padrão: OpenAI).
# Groq: https://api.groq.com/openai/v1/audio/transcriptions
# EVOLUTION_TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions
# Chave do serviço (ou deixe em OPENAI_API_KEY / GROQ_API_KEY)
# EVOLUTION_TRANSCRIBE_API_KEY=sk-...
# Modelo (padrão: whisper-1 na API; small no backend local)
# EVOLUTION_TRANSCRIBE_MODEL=whisper-1
# Idioma dos áudios; vazio = detecção automática
# EVOLUTION_TRANSCRIBE_LANGUAGE=pt
# EVOLUTION_TRANSCRIBE_TIMEOUT=120
# EVOLUTION_TRANSCRIBE_MAX_MB=25

# Opcional: arquivamento direto no Google Drive (servidor sobe o arquivo sozinho)
# Gere estes valores com: python scripts/google_oauth_setup.py
# EVOLUTION_DRIVE_CLIENT_ID=...apps.googleusercontent.com
# EVOLUTION_DRIVE_CLIENT_SECRET=...
# EVOLUTION_DRIVE_REFRESH_TOKEN=...
# Id da pasta base criada pelo próprio app (o script cria e informa)
# EVOLUTION_DRIVE_ROOT_ID=...
# Subpasta dentro dela, opcional
# EVOLUTION_DRIVE_ROOT=

# Opcional: receptor de eventos da Evolution API (fase de observação do bot "IA:")
# Sem esta variável as rotas /webhook não existem. Gere um valor aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# EVOLUTION_WEBHOOK_SECRET=

# Opcional: o bot "IA:". DESLIGADO por padrão — ligar faz ele responder a terceiros.
# EVOLUTION_BOT_ENABLED=1
# ANTHROPIC_API_KEY=sk-ant-...
# Modelo (padrão: claude-opus-5). Para gastar menos: claude-sonnet-5
# EVOLUTION_BOT_MODEL=claude-opus-5
# Teto de gasto por dia, em dólares (0 = sem teto)
# EVOLUTION_BOT_DAILY_USD=2

# Opcional: onde registrar o que já foi tratado, para não responder duas vezes
# depois de um restart. Sem isto o registro vive só em memória.
# EVOLUTION_DB_URL=postgresql://postgres:SENHA@botai_pgdb:5432/evoapi
