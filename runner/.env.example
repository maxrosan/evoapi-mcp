# Copie para .env e preencha. Este arquivo NÃO vai para o git.

# Servidor MCP do EVOAPI (o mesmo que o conector do app usa)
MCP_URL=https://botai-evoapi-mcp.uuclvw.easypanel.host/mcp
MCP_AUTH_TOKEN=

# De quanto em quanto tempo perguntar ao servidor se há pendência (segundos).
# É só uma chamada HTTP, sem custo de modelo.
POLL_SECONDS=10

# Outros servidores MCP além do evoapi, separados por vírgula. Conectores da conta
# claude.ai usam o prefixo claude_ai_<Nome>: claude_ai_Trello, claude_ai_Gmail,
# claude_ai_Google_Calendar, claude_ai_Google_Drive. Servidores locais cadastrados
# com `claude mcp add <nome>` usam o próprio nome. Vazio = só o evoapi (mais barato).
# Para liberar só algumas ferramentas de um servidor, nomeie a ferramenta:
# <servidor>__<ferramenta>. Abaixo, Trello inteiro, e Gmail e Google Drive só de leitura.
EXTRA_MCP_SERVERS=claude_ai_Trello,claude_ai_Gmail__search_threads,claude_ai_Gmail__get_thread,claude_ai_Gmail__get_message,claude_ai_Gmail__list_labels,claude_ai_Google_Drive__search_files,claude_ai_Google_Drive__read_file_content,claude_ai_Google_Drive__get_file_metadata,claude_ai_Google_Drive__list_recent_files

# Fuso de Max, escrito no topo de cada acionamento para "amanhã às 9h" ter referência
TIMEZONE=America/Fortaleza

# Modelo e limites de cada acionamento do Claude
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_S=600

# Pausa antes de acordar o Claude, para a foto e o texto que Max manda em sequência
# chegarem juntos no mesmo acionamento (segundos).
SETTLE_SECONDS=8

# Depois de quantos acionamentos seguidos sem tirar nada da fila o executor
# para de insistir por BACKOFF_S segundos (o vigia do servidor avisa Max).
STUCK_RUNS=3
BACKOFF_S=300

# Pastas de código que o executor pode ler e buscar para investigar bugs, separadas por
# vírgula. Só leitura (Read, Grep, Glob); arquivos .env, chaves e credenciais ficam
# bloqueados. O executor roda git pull nelas a cada CODE_PULL_EVERY_S segundos.
# CODE_DIRS=D:/Codigos/Nara
# CODE_PULL_EVERY_S=900

# Pedidos de investigação (investigar, por que, bug, erro, falha, quebrou, não funciona,
# diagnóstico, ou a palavra "opus") rodam num modelo maior e com mais tempo; o resto usa
# CLAUDE_MODEL. INVESTIGATION_PATTERNS troca a lista (expressões regulares, sem acento,
# separadas por vírgula).
# INVESTIGATION_MODEL=opus
# INVESTIGATION_TIMEOUT_S=900
